{
  "name": "vexostream-edge-worker",
  "version": "25.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier --write \"src/**/*.ts\" scripts package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" scripts package.json tsconfig.json",
    "deploy": "npm test && wrangler deploy",
    "check": "npm run build && node --check dist/worker.js",
    "test": "npm run build && node --test scripts/test-checkhost.mjs scripts/test-api-v1.mjs",
    "flags": "node scripts/fetch-flags.mjs"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "esbuild": "^0.25.11",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.42.0"
  }
}
